#!/usr/bin/env bash
# set up by executing `git config core.hooksPath .githooks`

set -euo pipefail

echo "=== Pre-commit checks ==="

# 1. Rust format check
echo "[1/4] cargo fmt --check"
cargo fmt --check || {
    echo "FAILED: Code is not formatted. Run 'cargo fmt'."
    exit 1
}

# 2. Rust type check
echo "[2/4] cargo check"
cargo check || {
    echo "FAILED: Type check errors found."
    exit 1
}

# 3. Rust lint (clippy)
echo "[3/4] cargo clippy"
cargo clippy -- -D warnings || {
    echo "FAILED: Clippy warnings found."
    exit 1
}

# 4. gitleaks
echo "[4/4] gitleaks"
gitleaks git --pre-commit --redact --staged --verbose

echo "=== All checks passed ==="
